# Copiá este archivo a .env y completá los valores.

# Token que inventás vos; el mismo se carga en Meta al configurar el webhook.
VERIFY_TOKEN=

# App secret de la app de Meta: se usa para verificar la firma del webhook.
APP_SECRET=

# Token de acceso de WhatsApp Cloud API (idealmente de un usuario del sistema).
WHATSAPP_TOKEN=

# Clave de la API de Gemini (Google AI Studio).
GOOGLE_API_KEY=

# Conexión a PostgreSQL, ej. postgresql://usuario:clave@host:5432/base
DATABASE_URL=

# Opcional: cuenta de WhatsApp Business por defecto para scripts.suscribir.
WABA_ID=
